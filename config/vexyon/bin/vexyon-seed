#!/usr/bin/env bash
# Vexyon — siembra el estado de usuario. Copia-si-no-existe, idempotente.
#
# En Arch esto lo hace install.sh: despliega el árbol entero en ~/.config/vexyon
# porque allí el CÓDIGO y la CONFIGURACIÓN viven en el mismo sitio. En NixOS el
# código está en el store (solo lectura) y en $HOME solo puede quedar lo que el
# propio shell reescribe en caliente:
#
#   ~/.config/vexyon/shell.json          la config viva — la escribe Ajustes
#   ~/.config/hypr/hyprland.lua          raíz estática de Hyprland
#   ~/.config/hypr/vexyon-env.lua        entorno estático
#   ~/.local/share/vexyon/themes/        temas (la tienda instala y borra aquí)
#   ~/.local/share/vexyon/store/         catálogo de la tienda de temas
#   ~/.local/share/vexyon/defaults/      keybinds por defecto
#
# NUNCA pisa un fichero existente: la config del usuario manda siempre. Lo
# llama vexyon-start al entrar en sesión, así que no hay demonio ni unidad de
# systemd nueva — en un $HOME ya sembrado cuesta un `stat` por fichero.
#
# VEXYON_SHARE: raíz de los datos del paquete (share/vexyon del store).
set -euo pipefail

SHARE="${VEXYON_SHARE:?vexyon-seed: VEXYON_SHARE no definido}"
CFG="$HOME/.config/vexyon"
HYPR="$HOME/.config/hypr"
DATA="$HOME/.local/share/vexyon"

seeded=0

# copy_if_absent <origen> <destino>
copy_if_absent() {
  [ -e "$2" ] && return 0
  [ -e "$1" ] || return 0
  mkdir -p "$(dirname "$2")"
  cp "$1" "$2"
  chmod u+w "$2"          # el store es 444: sin esto la config nace inmutable
  seeded=$((seeded + 1))
}

# seed_tree <dir origen> <dir destino> — fichero a fichero, respetando los que
# ya existan (un `cp -r` del store dejaría todo en solo lectura y borraría los
# temas que el usuario haya instalado desde la tienda).
seed_tree() {
  local src=$1 dst=$2 f rel
  [ -d "$src" ] || return 0
  while IFS= read -r -d '' f; do
    rel=${f#"$src"/}
    copy_if_absent "$f" "$dst/$rel"
  done < <(find "$src" -type f -print0)
}

mkdir -p "$CFG" "$HYPR" "$DATA" \
         "$HOME/Pictures/Wallpapers" "$HOME/Pictures/Screenshots"

copy_if_absent "$SHARE/seed/shell.json"     "$CFG/shell.json"
# TODAS las raíces Lua, no solo las estáticas: hyprland.lua hace require() de
# vexyon-keybinds/settings/monitors sin condición, así que si faltan en el
# primer arranque la config aborta y la sesión se queda sin shell. El bridge
# las reescribe en cuanto corre; estas son solo la semilla.
seed_tree      "$SHARE/hypr"                "$HYPR"
seed_tree      "$SHARE/seed/themes"         "$DATA/themes"
seed_tree      "$SHARE/seed/store"          "$DATA/store"
seed_tree      "$SHARE/seed/defaults"       "$DATA/defaults"

# Distribución de teclado. Hyprland NO hereda la del sistema: sin esto la
# sesión (y el greeter) se quedan en "us" y una contraseña con caracteres que
# cambian de sitio entre distribuciones no se puede teclear. En Arch esto lo
# siembra install.sh leyendo la config del OS; aquí la fuente es el módulo de
# NixOS, que la deduce de su propio `config` (services.xserver.xkb.layout, si
# no console.keyMap) y la exporta.
#
# SEMILLA, no override: solo si la clave todavía no existe. A partir de ahí
# manda Ajustes → Comportamiento, exactamente igual que en Arch. Si las
# variables no están definidas (Arch), esto no hace nada.
seed_kb_layout() {
  local kb="${VEXYON_KB_LAYOUT:-}" var="${VEXYON_KB_VARIANT:-}" tmp
  [ -n "$kb" ] || return 0
  # "us" sin variante es ya el defecto del shell: no hace falta escribir nada.
  if [ "$kb" = "us" ] && [ -z "$var" ]; then return 0; fi
  command -v jq >/dev/null 2>&1 || return 0
  [ -f "$CFG/shell.json" ] || return 0
  # Clave ya presente = elección del usuario. No se toca.
  if jq -e '.behavior.keyboardLayout' "$CFG/shell.json" >/dev/null 2>&1; then return 0; fi
  tmp=$(mktemp) || return 0
  if jq --arg kb "$kb" --arg var "$var" \
       '.behavior.keyboardLayout = $kb
        | if $var == "" then . else .behavior.keyboardVariant = $var end' \
       "$CFG/shell.json" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    mv "$tmp" "$CFG/shell.json"
    echo "vexyon-seed: teclado sembrado del sistema: $kb${var:+ ($var)}"
  else
    rm -f "$tmp"
  fi
}
seed_kb_layout

# Binds NUEVOS en un $HOME ya sembrado. shell.json no se pisa NUNCA (la config
# del usuario manda), así que un bind añadido al shell después de su primera
# entrada no le llegaría jamás: ni las teclas multimedia en su día, ni ahora
# Super+V para el gestor de VMs. Se siembra UNA vez cada bind de la lista cuyo
# id todavía no exista, y se salta si el usuario ya usa ese combo para otra cosa.
#
# La lista es EXPLÍCITA a propósito: "todo default que falte" resucitaría
# cualquier bind que el usuario haya borrado a conciencia. Misma idea y mismo
# código que el paso equivalente del install.sh de Arch.
seed_late_keybinds() {
  [ -f "$CFG/shell.json" ] || return 0
  [ -f "$DATA/defaults/keybinds.json" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 - "$CFG/shell.json" "$DATA/defaults/keybinds.json" <<'PYEOF' || true
import json, os, sys
sj, dk = sys.argv[1], sys.argv[2]
LATE = {"vmmanager"}
try:
    cfg = json.load(open(sj))
    defaults = json.load(open(dk))
except Exception:
    raise SystemExit(0)          # config a medio escribir: ya se intentara
kbs = cfg.setdefault("keybinds", [])
have_ids = {k.get("id") for k in kbs}
combos = {(tuple(sorted(k.get("mods", []))), k.get("key")) for k in kbs}
added = []
for k in defaults:
    if k.get("category") != "Media" and k.get("id") not in LATE:
        continue
    if k.get("id") in have_ids:
        continue
    if (tuple(sorted(k.get("mods", []))), k.get("key")) in combos:
        continue                 # ese combo ya lo usa el usuario para otra cosa
    kbs.append(k)
    added.append(k["id"])
if added:
    tmp = sj + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cfg, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, sj)
    print("vexyon-seed: atajo(s) sembrado(s): " + ", ".join(added))
PYEOF
}
seed_late_keybinds

# El pin de GPU lo genera el sistema (regla udev / el módulo). Si no existe aún,
# dejar un fragmento vacío: hyprland.lua hace require("vexyon-gpu") y sin
# fichero la sesión no arranca.
if [ ! -e "$HYPR/vexyon-gpu.lua" ]; then
  printf -- '-- Vexyon — GPU pin (GENERATED)\n-- No GPU pin yet: vexyon-seed placeholder.\n' \
    > "$HYPR/vexyon-gpu.lua"
  seeded=$((seeded + 1))
fi

[ "$seeded" -gt 0 ] && echo "vexyon-seed: $seeded fichero(s) sembrado(s)"
exit 0
