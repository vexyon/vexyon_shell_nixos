#!/usr/bin/env bash
# Vexyon — handler de hotplug de GPU (root, disparado por udev; instalado en
# /usr/local/bin SOLO en máquinas híbridas — regla 91-vexyon-gpu-hotplug.rules,
# ACTION=change en cardN). NO es un daemon: recalcula la decisión con
# vexyon-gpu-detect, y si el conf generado NO cambia (evento de ruido: DPMS,
# re-probe, un segundo monitor en la misma GPU) sale inmediatamente.
#
# Si el conf SÍ cambia (una pantalla cruzó la frontera iGPU/dGPU):
#   1. reescribe ~/.config/hypr/vexyon-gpu.lua del usuario (dueño preservado)
#      y la copia del kiosco del greeter,
#   2. deja el flag vexyon-gpu-restart en el runtime dir del dueño de cada
#      Hyprland vivo y le manda SIGTERM: vexyon-start ve el flag y RELANZA
#      Hyprland dentro de la MISMA sesión de login (sin reboot, sin re-login);
#      el kiosco del greeter lo respawnea greetd solo.
set -u

HOME_DIR="${1:?usage: vexyon-gpu-hotplug /home/USER}"
# Config Lua de Hyprland (>= 0.55); hyprlang desaparece en 0.57.
CONF="$HOME_DIR/.config/hypr/vexyon-gpu.lua"
# Snapshots mutables del greeter. En Arch viven en /etc/greetd/vexyon-greeter;
# en NixOS /etc lo maneja Nix (symlinks de solo lectura) y el módulo apunta
# esta variable a /var/lib/vexyon-greeter. VEXYON_GREETER_DIR se mantiene como
# alias del nombre antiguo para no romper instalaciones/tests existentes.
GREET_DIR="${VEXYON_GREETER_STATE_DIR:-${VEXYON_GREETER_DIR:-/etc/greetd/vexyon-greeter}}"
RUN_BASE="${VEXYON_RUN_BASE:-/run/user}"
LOCK="${VEXYON_GPU_LOCK:-/run/vexyon-gpu-hotplug.lock}"
DETECT="${VEXYON_GPU_DETECT:-/usr/local/bin/vexyon-gpu-detect}"

# Un plug genera una ráfaga de eventos change (uno por conector re-probado):
# serializar; los siguientes ven el conf ya reescrito y salen por el compare.
exec 9>"$LOCK"
flock 9

desired="$("$DETECT" lua)" || exit 0
current="$(cat "$CONF" 2>/dev/null || true)"
[ "$desired" = "$current" ] && exit 0

[ -d "${CONF%/*}" ] || exit 0
printf '%s\n' "$desired" > "$CONF.tmp"
chown --reference="$HOME_DIR" "$CONF.tmp" 2>/dev/null || true
mv "$CONF.tmp" "$CONF"
if [ -d "$GREET_DIR" ]; then
  printf '%s\n' "$desired" > "$GREET_DIR/vexyon-gpu.lua"
fi

# Reiniciar el compositor que esté vivo (sesión O greeter — nunca conviven
# salvo el instante del handoff). El flag va ANTES del SIGTERM.
#
# Buscar por NOMBRE no basta en todas partes: en NixOS el binario va envuelto y
# el comm que ve el kernel es ".Hyprland-wrapp" (truncado a 15 caracteres), así
# que `pgrep -x Hyprland` no encuentra nada y el hotplug reescribiría el conf
# sin reiniciar nunca el compositor. Se une la búsqueda por nombre (Arch) con
# una por línea de órdenes (el binario real, con o sin el punto del wrapper).
# `/bin/Hyprland` con H mayúscula no casa ni start-hyprland ni
# xdg-desktop-portal-hyprland. Un pid espurio no hace daño: el bucle lo
# descarta al no encontrarle runtime dir.
hypr_pids() {
  { pgrep -x Hyprland || true; pgrep -f '/bin/[.]?Hyprland' || true; } 2>/dev/null \
    | sort -un
}

for pid in $(hypr_pids); do
  uid="$(stat -c %u "/proc/$pid" 2>/dev/null)" || continue
  rd="$RUN_BASE/$uid"
  if [ -d "$rd" ]; then
    : > "$rd/vexyon-gpu-restart"
    chown "$uid" "$rd/vexyon-gpu-restart" 2>/dev/null || true
  fi
  kill -TERM "$pid" 2>/dev/null || true
done
exit 0
