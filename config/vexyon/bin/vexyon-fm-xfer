#!/usr/bin/env python3
"""
vexyon-fm-xfer — copia y mueve ficheros DICIENDO POR DÓNDE VA.

    copy <destino> <origen>…
    move <destino> <origen>…

POR QUÉ EXISTE Y NO SE USA `cp`/`mv` A SECAS
--------------------------------------------
El gestor de ficheros llamaba a `cp -rn` / `mv -n` y no había forma de saber si
la copia seguía viva: coreutils no informa de progreso por ningún sitio. Y las
tres rutas que el usuario nota lentas —disco externo, SFTP y copia local entre
sistemas de ficheros— son EXACTAMENTE la misma ruta: el SFTP del gestor se monta
con sshfs, así que para el proceso que copia todo son rutas del sistema de
ficheros. Con arreglar una, quedan arregladas las tres.

Se descartó `gio copy --progress`, que ya estaba a mano (el gestor usa `gio` para
la papelera), por dos motivos MEDIDOS, no supuestos:

  1. `gio copy` MACHACA el destino sin preguntar. Comprobado: un fichero con
     "ORIGINAL" dentro acabó con "NUEVO" después de un `gio copy`, mientras que
     `cp -n` lo dejó intacto. Cambiar a gio habría convertido una colisión de
     nombres en pérdida de datos silenciosa. El "no machacar nunca" que ya tenía
     el gestor no se negocia.
  2. Su progreso no sirve para una barra: escribe "125,8 MB copiados (promedio:
     6,6 GB/s)" — traducido al idioma del usuario, con coma decimal y SIN TOTAL.
     Sin denominador no hay porcentaje que valga.

python3 ya es dependencia dura del shell (el bridge, los ayudantes de VM, el
generador de fondos), así que esto no añade nada nuevo.

PROTOCOLO (líneas sueltas por STDOUT, se leen según llegan)
-----------------------------------------------------------
    @@TOTAL <bytes> <ficheros>       ya se sabe cuánto hay que mover
    @@FILE  <n> <de> <nombre>        empieza el fichero n de <de>
    @@PROG  <hechos> <total>         bytes acumulados de TODA la operación
    @@SKIP  <nombre>                 el destino ya existía: NO se ha tocado
    @@ERR   <nombre> <motivo>        ese elemento ha fallado; se sigue con el resto
    @@DONE  <copiados> <saltados> <fallos>

No hay sondeo por ninguna parte: cada línea la empuja el propio dato que acaba
de pasar por el buffer.
"""
import errno
import os
import shutil
import sys

CHUNK = 1 << 20          # 1 MiB
TICK = 4 << 20           # una línea de progreso cada 4 MiB
# Sufijo del fichero a medio escribir. Lleva el PID a propósito: dos
# transferencias EN PARALELO pueden estar copiando un fichero con el mismo
# nombre a la misma carpeta, y con un sufijo fijo las dos escribirían en el
# MISMO temporal y se corromperían la una a la otra sin que nadie se entere.
PART = ".vexyon-part-%d" % os.getpid()


def emit(line):
    sys.stdout.write(line + "\n")
    sys.stdout.flush()   # sin esto el gestor no ve nada hasta el final


def clean(s):
    """Los tabuladores y saltos de un nombre de fichero desalinearían las
    columnas del protocolo. Un nombre puede tener de todo."""
    return str(s).replace("\t", " ").replace("\n", " ").replace("\r", " ")


def die(msg):
    sys.stderr.write("vexyon-fm-xfer: %s\n" % msg)
    raise SystemExit(2)


# ---------------------------------------------------------------------------
# recuento previo
# ---------------------------------------------------------------------------
def scan(srcs, dest):
    """Devuelve (trabajos, bytes_totales).

    Cada trabajo es (origen, destino, es_directorio). Los directorios van antes
    que su contenido para poder crearlos por orden.

    Los enlaces simbólicos NO se siguen: se recrean como enlaces. Seguirlos
    podría meter en la copia medio disco (o un bucle) sin que nadie lo pida.
    """
    jobs, total = [], 0
    for src in srcs:
        src = src.rstrip("/")
        name = os.path.basename(src)
        if not name:
            continue
        dst = os.path.join(dest, name)
        if os.path.islink(src) or not os.path.isdir(src):
            jobs.append((src, dst, False))
            try:
                total += os.lstat(src).st_size
            except OSError:
                pass
            continue
        jobs.append((src, dst, True))
        for root, dirs, files in os.walk(src, followlinks=False):
            rel = os.path.relpath(root, src)
            base = dst if rel == "." else os.path.join(dst, rel)
            for d in dirs:
                jobs.append((os.path.join(root, d), os.path.join(base, d), True))
            for f in files:
                s = os.path.join(root, f)
                jobs.append((s, os.path.join(base, f), False))
                try:
                    total += os.lstat(s).st_size
                except OSError:
                    pass
    return jobs, total


# ---------------------------------------------------------------------------
# copiar un fichero contando
# ---------------------------------------------------------------------------
class Progress(object):
    def __init__(self, total):
        self.total = total
        self.done = 0
        self.last = 0

    def add(self, n):
        self.done += n
        if self.done - self.last >= TICK:
            self.last = self.done
            emit("@@PROG\t%d\t%d" % (self.done, self.total))

    def flush(self):
        self.last = self.done
        emit("@@PROG\t%d\t%d" % (self.done, self.total))


def copy_file(src, dst, prog):
    """Copia contando, y NO deja nunca un fichero a medias con el nombre bueno.

    Se escribe en `<dst>.vexyon-part` y solo al final se renombra. Si se
    desenchufa el disco, si se corta el SFTP o si se cierra la ventana a mitad,
    lo que queda es un `.vexyon-part` evidente, no un fichero con el nombre
    correcto y la mitad del contenido — que es lo que hace `cp` y lo que de
    verdad muerde después.
    """
    if os.path.islink(src):
        os.symlink(os.readlink(src), dst)
        # El enlace cuenta en el total (lstat da su tamaño), así que también
        # tiene que contar aquí o la barra se queda unos bytes corta del final.
        try:
            prog.add(os.lstat(dst).st_size)
        except OSError:
            pass
        return
    tmp = dst + PART
    try:
        with open(src, "rb") as fin, open(tmp, "wb") as fout:
            while True:
                buf = fin.read(CHUNK)
                if not buf:
                    break
                fout.write(buf)
                prog.add(len(buf))
            fout.flush()
            # ⚠️ fsync ANTES de dar el fichero por bueno. Sin esto, en un pen
            # drive la barra llega al 100 % mientras el kernel todavía tiene los
            # datos en caché sin escribir: el usuario ve "terminado", saca el
            # lápiz y se lleva un fichero a medias. Es justo el caso que más se
            # nota, así que se paga el coste.
            os.fsync(fout.fileno())
        shutil.copystat(src, tmp, follow_symlinks=False)
        # Se vuelve a mirar aquí, no solo al planificar: entre el recuento y
        # ahora ha podido aparecer algo con ese nombre, y `os.replace` machaca.
        if os.path.exists(dst):
            os.unlink(tmp)
            raise FileExistsError(errno.EEXIST, "el destino ha aparecido durante la copia")
        os.replace(tmp, dst)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# ---------------------------------------------------------------------------
# la operación
# ---------------------------------------------------------------------------
def run(mode, dest, srcs):
    if not os.path.isdir(dest):
        die("el destino no es una carpeta: %s" % dest)

    # Mover DENTRO del mismo sistema de ficheros es un renombrado: instantáneo,
    # no mueve un solo byte y no hay nada que medir. Se intenta primero, y solo
    # si el kernel dice EXDEV (destino en otro sistema de ficheros: disco
    # externo, sshfs, otra partición) se cae a copiar-y-borrar, que sí tarda.
    quick, rest = [], []
    if mode == "move":
        for src in srcs:
            s = src.rstrip("/")
            name = os.path.basename(s)
            if not name:
                continue
            dst = os.path.join(dest, name)
            if os.path.exists(dst):
                emit("@@SKIP\t%s" % clean(name))
                continue
            try:
                os.rename(s, dst)
                quick.append(name)
            except OSError as e:
                if e.errno == errno.EXDEV:
                    rest.append(s)
                else:
                    emit("@@ERR\t%s\t%s" % (clean(name), clean(e.strerror or e)))
        if not rest:
            emit("@@TOTAL\t0\t%d" % len(quick))
            emit("@@DONE\t%d\t0\t0" % len(quick))
            return 0
        srcs = rest

    jobs, total = scan(srcs, dest)
    files = [j for j in jobs if not j[2]]
    emit("@@TOTAL\t%d\t%d" % (total, len(files)))
    prog = Progress(total)

    copied = skipped = failed = 0
    index = 0
    # Los directorios de los que sí se ha copiado todo, para poder borrarlos al
    # final si esto era un `move`.
    for src, dst, is_dir in jobs:
        name = os.path.basename(dst)
        if is_dir:
            try:
                os.makedirs(dst, exist_ok=True)
            except OSError as e:
                failed += 1
                emit("@@ERR\t%s\t%s" % (clean(name), clean(e.strerror or e)))
            continue
        index += 1
        emit("@@FILE\t%d\t%d\t%s" % (index, len(files), clean(name)))
        if os.path.lexists(dst):
            # Misma promesa que `cp -n` / `mv -n`: no se machaca NUNCA.
            skipped += 1
            emit("@@SKIP\t%s" % clean(name))
            try:
                prog.add(os.lstat(src).st_size)
            except OSError:
                pass
            continue
        try:
            copy_file(src, dst, prog)
            copied += 1
        except OSError as e:
            failed += 1
            emit("@@ERR\t%s\t%s" % (clean(name), clean(e.strerror or e)))
        prog.flush()

    # Un `move` entre sistemas de ficheros solo borra el origen de lo que se ha
    # copiado ENTERO y bien. Si algo falló o se saltó, el origen se queda: es
    # preferible una copia duplicada a un borrado que no tocaba.
    if mode == "move" and failed == 0 and skipped == 0:
        for src in srcs:
            try:
                if os.path.islink(src) or not os.path.isdir(src):
                    os.unlink(src)
                else:
                    shutil.rmtree(src)
            except OSError as e:
                emit("@@ERR\t%s\t%s" % (clean(os.path.basename(src)),
                                        clean(e.strerror or e)))

    copied += len(quick)
    emit("@@DONE\t%d\t%d\t%d" % (copied, skipped, failed))
    return 1 if failed else 0


def main():
    if len(sys.argv) < 4 or sys.argv[1] not in ("copy", "move"):
        die("uso: vexyon-fm-xfer <copy|move> <destino> <origen>…")
    try:
        raise SystemExit(run(sys.argv[1], sys.argv[2].rstrip("/"), sys.argv[3:]))
    except KeyboardInterrupt:
        raise SystemExit(130)


if __name__ == "__main__":
    main()
