#!/usr/bin/env bash
# Sincroniza el tema activo, el idioma y el teclado de Vexyon con el greeter
# (greetd). El greeter corre ANTES de la sesión de usuario y no puede leer
# $HOME, así que usa snapshots estáticos en el directorio de estado del
# greeter: theme.json, el campo "lang" de greeter.json e input.lua (teclado).
# El TEMA lo re-sincroniza solo el bridge en cada cambio (theme.json es
# propiedad del usuario desde install.sh); ejecuta esto para idioma/teclado, o
# para el tema en instalaciones anteriores donde theme.json aún es de root.
#
# VEXYON_GREETER_STATE_DIR: en Arch es /etc/greetd/vexyon-greeter (el valor por
# defecto); en NixOS /etc lo maneja Nix (symlinks de solo lectura) y el módulo
# lo apunta a /var/lib/vexyon-greeter, que además es del usuario — ahí esto no
# necesita sudo.
set -euo pipefail

CFG="$HOME/.config/vexyon/shell.json"
STATE="${VEXYON_GREETER_STATE_DIR:-/etc/greetd/vexyon-greeter}"
DEST="$STATE/theme.json"
GJSON="$STATE/greeter.json"
INPUT_LUA="$STATE/input.lua"
CURSOR_LUA="$STATE/cursor.lua"

# En Arch el directorio es de root y hace falta sudo; en NixOS es del usuario.
# Decidirlo por permiso real, no por distro.
if [ -w "$STATE" ]; then SUDO=(); else SUDO=(sudo); fi

active=$(jq -r '.theme.active // empty' "$CFG" 2>/dev/null || true)
if [ -z "$active" ]; then
  echo "No hay tema activo en $CFG" >&2
  exit 1
fi

src="$HOME/.local/share/vexyon/themes/$active.json"
if [ ! -f "$src" ]; then
  echo "Tema '$active' no encontrado en $src" >&2
  exit 1
fi

# -o "$USER": el fichero debe seguir siendo del usuario para que el bridge
# pueda re-sincronizarlo solo en los próximos cambios de tema (sin sudo)
"${SUDO[@]}" install -Dm644 -o "$USER" "$src" "$DEST"
echo "Greeter → tema '$active' ($DEST)"

lang=$(jq -r '.appearance.language // "en"' "$CFG" 2>/dev/null || echo en)
[ "$lang" = "es" ] || lang="en"
user=$(jq -r '.user // empty' "$GJSON" 2>/dev/null || true)
[ -n "$user" ] || user="$USER"
printf '{ "user": "%s", "lang": "%s" }\n' "$user" "$lang" | "${SUDO[@]}" tee "$GJSON" >/dev/null
echo "Greeter → idioma '$lang' ($GJSON)"

# Teclado del kiosco del greeter = el de la sesión (la contraseña debe
# teclearse con la misma distribución). Antes esto parcheaba hyprland.lua con
# `sed -i`; ahora es un fragmento Lua GENERADO aparte, igual que el pin de GPU.
# El kiosco lo carga con dofile, así que su hyprland.lua puede vivir en un
# store de solo lectura (NixOS) y seguir teniendo teclado configurable en
# caliente — y en Arch desaparece un sed con sudo contra un fichero de config.
# Solo si el usuario tiene una elección EXPLÍCITA. Antes esto caía a "us"
# cuando la clave no existía y escribía ese "us" en el greeter, tapando la
# distribución que el sistema ya había configurado — y dejando una pantalla de
# login donde la contraseña no se podía teclear. Sin clave: no se escribe nada
# y manda el defecto del sistema.
kb=$(jq -r '.behavior.keyboardLayout // empty' "$CFG" 2>/dev/null || true)
if [ -n "$kb" ]; then
  case "$kb" in latam|ara|[a-z][a-z]) : ;; *) kb=us ;; esac
  kbv=$(jq -r '.behavior.keyboardVariant // ""' "$CFG" 2>/dev/null || echo "")
  case "$kbv" in "" | [a-z0-9_-]*) : ;; *) kbv="" ;; esac
  printf -- '-- Vexyon — greeter input (GENERATED by vexyon-greeter-sync-theme)\nhl.config({ input = { kb_layout = "%s", kb_variant = "%s" } })\n' \
    "$kb" "$kbv" | "${SUDO[@]}" tee "$INPUT_LUA" >/dev/null
  echo "Greeter → teclado '$kb${kbv:+ ($kbv)}' ($INPUT_LUA)"
else
  echo "Greeter → teclado: sin elección en shell.json, se deja el del sistema"
fi

# Cursor del greeter = el de la sesión, para que el puntero no cambie de pinta
# al entrar. Mismo patrón: fragmento Lua que el kiosco carga con dofile.
cursor=$(jq -r '.appearance.cursorTheme // "pretty"' "$CFG" 2>/dev/null || echo pretty)
if [ "$cursor" = "system" ]; then
  cursor_theme="default"
else
  cursor_theme="${VEXYON_PRETTY_CURSOR_THEME:-Bibata-Modern-Ice}"
fi
printf -- '-- Vexyon — greeter cursor (GENERATED by vexyon-greeter-sync-theme)\nhl.env("XCURSOR_THEME", "%s")\nhl.env("XCURSOR_SIZE", "24")\n' \
  "$cursor_theme" | "${SUDO[@]}" tee "$CURSOR_LUA" >/dev/null
echo "Greeter → cursor '$cursor_theme' ($CURSOR_LUA)"
