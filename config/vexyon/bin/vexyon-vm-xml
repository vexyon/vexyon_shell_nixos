#!/usr/bin/env python3
"""
vexyon-vm-xml — editor del XML de dominio de libvirt para el gestor de VMs.

FILTRO PURO: lee el XML del dominio por STDIN y escribe el XML modificado por
STDOUT. Quien lo llama encadena
    virsh dumpxml NAME | vexyon-vm-xml <orden> ... | virsh define /dev/stdin
así que este programa NUNCA habla con libvirt ni toca ficheros: no puede
romper nada por su cuenta y se puede probar con un fichero suelto.

La excepción es `info`, que en vez de XML emite registros TSV por secciones
`@@…` para que el QML los parsee igual que el resto de sondas del shell.

Por qué existe: editar el XML a base de sed/grep es una fuente de bugs, y
`virsh edit` exige un $EDITOR interactivo. Python3 con `xml.etree` de la
biblioteca ESTÁNDAR **no añade ninguna dependencia**: el shell ya depende de
python3 (el bridge `vexyon-bridge.py`, y `pythonEnv` en el módulo Nix / el
paquete `python` en install.sh).
"""
import os
import sys
import xml.etree.ElementTree as ET

# --------------------------------------------------------------------------
# utilidades
# --------------------------------------------------------------------------

def devices(root):
    d = root.find("devices")
    if d is None:
        d = ET.SubElement(root, "devices")
    return d


def die(msg):
    sys.stderr.write("vexyon-vm-xml: %s\n" % msg)
    raise SystemExit(1)


def emit(root):
    sys.stdout.write(ET.tostring(root, encoding="unicode"))


def rec(section, *fields):
    """Una fila TSV. Los tabuladores y saltos de los valores se neutralizan:
    el parseo del QML corta por \\t y por \\n, así que un nombre con un tabulador
    dentro desalinearía las columnas."""
    clean = [str(f).replace("\t", " ").replace("\n", " ") for f in fields]
    sys.stdout.write("%s\t%s\n" % (section, "\t".join(clean)))


def text_of(el, default=""):
    return (el.text or default).strip() if el is not None else default


# --------------------------------------------------------------------------
# info — volcado legible del hardware del dominio
# --------------------------------------------------------------------------

def cmd_info(root, argv):
    dev = root.find("devices")
    if dev is None:
        dev = ET.Element("devices")

    for dsk in dev.findall("disk"):
        src = dsk.find("source")
        tgt = dsk.find("target")
        drv = dsk.find("driver")
        path = ""
        if src is not None:
            # file / block / dir según el `type` del disco
            path = src.get("file") or src.get("dev") or src.get("dir") or ""
        rec("@@DISK",
            tgt.get("dev", "") if tgt is not None else "",
            tgt.get("bus", "") if tgt is not None else "",
            dsk.get("device", "disk"),
            path,
            drv.get("type", "") if drv is not None else "",
            "ro" if dsk.find("readonly") is not None else "rw")

    for nic in dev.findall("interface"):
        mac = nic.find("mac")
        src = nic.find("source")
        mdl = nic.find("model")
        link = nic.find("link")
        source = ""
        if src is not None:
            source = (src.get("network") or src.get("bridge")
                      or src.get("dev") or src.get("portgroup") or "")
        rec("@@NIC",
            mac.get("address", "") if mac is not None else "",
            nic.get("type", ""),
            source,
            mdl.get("type", "") if mdl is not None else "",
            link.get("state", "up") if link is not None else "up")

    for c in dev.findall("controller"):
        rec("@@CTRL", c.get("type", ""), c.get("index", ""), c.get("model", ""))

    for v in dev.findall("video"):
        m = v.find("model")
        if m is None:
            continue
        rec("@@VIDEO", m.get("type", ""), m.get("vram", ""), m.get("heads", "1"))

    cpu = root.find("cpu")
    topo = cpu.find("topology") if cpu is not None else None
    rec("@@CPU",
        topo.get("sockets", "") if topo is not None else "",
        topo.get("cores", "") if topo is not None else "",
        topo.get("threads", "") if topo is not None else "",
        cpu.get("mode", "") if cpu is not None else "")

    osnode = root.find("os")
    if osnode is not None:
        for b in osnode.findall("boot"):
            rec("@@BOOT", b.get("dev", ""))
        # firmware='efi' (autoselección) o un <loader> explícito = UEFI
        fw = osnode.get("firmware", "")
        if not fw and osnode.find("loader") is not None:
            fw = "efi"
        rec("@@FIRMWARE", fw or "bios")

    for ch in dev.findall("channel"):
        t = ch.find("target")
        rec("@@CHAN", t.get("name", "") if t is not None else "", ch.get("type", ""))

    for fs in dev.findall("filesystem"):
        s, t, drv = fs.find("source"), fs.find("target"), fs.find("driver")
        rec("@@FS",
            t.get("dir", "") if t is not None else "",
            (s.get("dir") or s.get("socket") or "") if s is not None else "",
            drv.get("type", "") if drv is not None else "",
            fs.get("accessmode", ""))

    for hd in dev.findall("hostdev"):
        if hd.get("type") != "usb":
            continue
        s = hd.find("source")
        if s is None:
            continue
        v, p = s.find("vendor"), s.find("product")
        rec("@@USBDEV",
            v.get("id", "") if v is not None else "",
            p.get("id", "") if p is not None else "")

    for g in dev.findall("graphics"):
        cb = g.find("clipboard")
        rec("@@GRAPHICS", g.get("type", ""),
            cb.get("copypaste", "") if cb is not None else "")

    # TPM: la UI necesita saber si HAY y de qué versión. Windows 11 se planta
    # en "El equipo debe admitir TPM 2.0" si no hay ninguno, y desde el XML del
    # dominio es lo único que se puede comprobar sin arrancar el invitado.
    for tp in dev.findall("tpm"):
        be = tp.find("backend")
        rec("@@TPM", tp.get("model", ""),
            be.get("type", "") if be is not None else "",
            be.get("version", "") if be is not None else "")

    for sd in dev.findall("sound"):
        rec("@@SOUND", sd.get("model", ""))
    rec("@@REDIR", len(dev.findall("redirdev")))
    rec("@@DESC", text_of(root.find("description")))
    rec("@@TITLE", text_of(root.find("title")))


# --------------------------------------------------------------------------
# órdenes de edición
# --------------------------------------------------------------------------

def cmd_boot(root, argv):
    """boot hd,cdrom,network — reescribe el orden de arranque de <os>."""
    order = [d for d in argv[0].split(",") if d]
    osnode = root.find("os")
    if osnode is None:
        die("el dominio no tiene <os>")
    for b in osnode.findall("boot"):
        osnode.remove(b)
    # <boot> dentro de <os> y por-dispositivo son EXCLUYENTES en libvirt: si
    # algún disco/NIC lleva <boot order=…>, el <os><boot dev=…> es un error.
    for el in root.iter():
        for b in list(el.findall("boot")):
            if el.tag in ("disk", "interface", "hostdev", "redirdev"):
                el.remove(b)
    for d in order:
        ET.SubElement(osnode, "boot", {"dev": d})
    return root


def cmd_video(root, argv):
    """video <modelo> [vramKiB] [heads]"""
    model, vram = argv[0], (argv[1] if len(argv) > 1 else "")
    heads = argv[2] if len(argv) > 2 else "1"
    dev = devices(root)
    vids = dev.findall("video")
    if not vids:
        vids = [ET.SubElement(dev, "video")]
    for v in vids:
        m = v.find("model")
        if m is None:
            m = ET.SubElement(v, "model")
        m.set("type", model)
        m.set("heads", heads)
        # `ram`/`vgamem`/`vram64` son EXCLUSIVOS de qxl: si se cambia a virtio o
        # vga y se dejan puestos, libvirt rechaza la definición con
        # "ram attribute only supported for video type qxl" (medido en 12.2.0).
        # Se limpian siempre y se reponen solo los que valgan para el modelo.
        for attr in ("ram", "vgamem", "vram64", "vram"):
            m.attrib.pop(attr, None)
        # virtio-gpu dimensiona su memoria solo; el resto acepta `vram`.
        if vram and model != "virtio":
            m.set("vram", vram)
    return root


def cmd_cpu(root, argv):
    """cpu <sockets> <cores> <threads> — 0 0 0 borra la topología."""
    s, c, t = argv[0], argv[1], argv[2]
    cpu = root.find("cpu")
    if cpu is None:
        cpu = ET.SubElement(root, "cpu", {"mode": "host-passthrough"})
    topo = cpu.find("topology")
    if s == "0" or c == "0" or t == "0":
        if topo is not None:
            cpu.remove(topo)
        return root
    if topo is None:
        topo = ET.SubElement(cpu, "topology")
    topo.set("sockets", s)
    topo.set("cores", c)
    topo.set("threads", t)
    return root


SPICE_AGENT = "com.redhat.spice.0"


def cmd_spice_agent(root, argv):
    """spice-agent on|off — el canal que necesita spice-vdagent del INVITADO.

    Sin este canal NO hay portapapeles compartido NI redimensionado automático
    del invitado, por bien configurado que esté el sistema de dentro.
    """
    on = argv[0] == "on"
    dev = devices(root)
    have = None
    for ch in dev.findall("channel"):
        t = ch.find("target")
        if t is not None and t.get("name") == SPICE_AGENT:
            have = ch
            break
    if on and have is None:
        ch = ET.SubElement(dev, "channel", {"type": "spicevmc"})
        ET.SubElement(ch, "target", {"type": "virtio", "name": SPICE_AGENT})
    elif not on and have is not None:
        dev.remove(have)
    return root


def cmd_clipboard(root, argv):
    """clipboard on|off — portapapeles de SPICE (necesita el agente invitado)."""
    on = argv[0] == "on"
    for g in devices(root).findall("graphics"):
        if g.get("type") != "spice":
            continue
        cb = g.find("clipboard")
        if cb is None:
            cb = ET.SubElement(g, "clipboard")
        cb.set("copypaste", "yes" if on else "no")
    return root


def cmd_usbredir(root, argv):
    """usbredir <n> — n canales de redirección USB por SPICE."""
    n = max(0, int(argv[0]))
    dev = devices(root)
    for r in dev.findall("redirdev"):
        dev.remove(r)
    for _ in range(n):
        ET.SubElement(dev, "redirdev", {"bus": "usb", "type": "spicevmc"})
    return root


def expand(p):
    """~ y $HOME -> ruta real. libvirt NO es un shell: una `~` se guardaría
    literal y fallaría con «Cannot access storage file '~/…'»."""
    return os.path.abspath(os.path.expanduser(os.path.expandvars(p)))


def cmd_fs_add(root, argv):
    """fs-add <ruta-anfitrión> <etiqueta> — carpeta compartida por virtiofs."""
    src, tag = expand(argv[0]), argv[1]
    dev = devices(root)
    for fs in dev.findall("filesystem"):
        t = fs.find("target")
        if t is not None and t.get("dir") == tag:
            die("ya existe una carpeta compartida con la etiqueta %r" % tag)
    fs = ET.SubElement(dev, "filesystem", {"type": "mount", "accessmode": "passthrough"})
    ET.SubElement(fs, "driver", {"type": "virtiofs"})
    ET.SubElement(fs, "source", {"dir": src})
    ET.SubElement(fs, "target", {"dir": tag})
    # virtiofs EXIGE memoria compartida; sin esto el dominio no arranca.
    mb = root.find("memoryBacking")
    if mb is None:
        mb = ET.SubElement(root, "memoryBacking")
    if mb.find("source") is None:
        ET.SubElement(mb, "source", {"type": "memfd"})
    if mb.find("access") is None:
        ET.SubElement(mb, "access", {"mode": "shared"})
    return root


def cmd_fs_del(root, argv):
    tag = argv[0]
    dev = devices(root)
    for fs in dev.findall("filesystem"):
        t = fs.find("target")
        if t is not None and t.get("dir") == tag:
            dev.remove(fs)
    return root


def cmd_usb_add(root, argv):
    """usb-add <vendorId> <productId> — pasa un USB del anfitrión al invitado."""
    ven, pro = argv[0], argv[1]
    dev = devices(root)
    hd = ET.SubElement(dev, "hostdev",
                       {"mode": "subsystem", "type": "usb", "managed": "yes"})
    s = ET.SubElement(hd, "source")
    ET.SubElement(s, "vendor", {"id": ven})
    ET.SubElement(s, "product", {"id": pro})
    return root


def cmd_usb_del(root, argv):
    ven, pro = argv[0], argv[1]
    dev = devices(root)
    for hd in dev.findall("hostdev"):
        if hd.get("type") != "usb":
            continue
        s = hd.find("source")
        if s is None:
            continue
        v, p = s.find("vendor"), s.find("product")
        if (v is not None and v.get("id") == ven
                and p is not None and p.get("id") == pro):
            dev.remove(hd)
            break
    return root


def cmd_controller_add(root, argv):
    """controller-add <tipo> <modelo> — índice = el primero libre de ese tipo."""
    ctype, model = argv[0], (argv[1] if len(argv) > 1 else "")
    dev = devices(root)
    used = set()
    for c in dev.findall("controller"):
        if c.get("type") == ctype:
            try:
                used.add(int(c.get("index", "0")))
            except ValueError:
                pass
    idx = 0
    while idx in used:
        idx += 1
    attrs = {"type": ctype, "index": str(idx)}
    if model:
        attrs["model"] = model
    ET.SubElement(dev, "controller", attrs)
    return root


def cmd_tpm(root, argv):
    """tpm on|off [modelo] — TPM 2.0 emulado por swtpm.

    ⚠️ SIN ESTO Windows 11 NO PASA DE LA PRIMERA PANTALLA: su comprobación de
    requisitos aborta con "El equipo debe admitir TPM 2.0". El asistente no
    ponía NINGÚN <tpm> en el dominio (medido: `virsh dumpxml win11` no tenía
    ni la etiqueta), así que el invitado no veía ningún TPM que examinar.

    El respaldo es `emulator`, o sea swtpm, que libvirtd lanza por VM. NO hace
    falta que swtpm esté en el PATH del usuario: en NixOS systemd se lo inyecta
    SOLO al servicio (medido: la unidad libvirtd lleva swtpm-0.10.1/bin en su
    Environment=PATH) y en Arch es un binario normal en /usr/bin. Vm.has.swtpm
    ya distingue los dos casos.

    `tpm-crb` es el modelo que espera Windows en una máquina q35/UEFI moderna;
    `tpm-tis` queda para invitados viejos y para i440fx.
    """
    on = argv[0] not in ("off", "0", "false", "no")
    model = argv[1] if len(argv) > 1 else "tpm-crb"
    dev = devices(root)
    for tp in dev.findall("tpm"):
        dev.remove(tp)
    if on:
        tp = ET.SubElement(dev, "tpm", {"model": model})
        ET.SubElement(tp, "backend", {"type": "emulator", "version": "2.0"})
    return root


def cmd_scsi_virtio(root, argv):
    """scsi-virtio — toda controladora SCSI autoelegida pasa a virtio-scsi.

    ⚠️ ESTA ES LA CAUSA DE "cargo el driver de virtio-win y los discos SCSI
    siguen sin salir". `virsh attach-disk --targetbus scsi` NO declara modelo,
    y entonces lo elige libvirt: pone **lsilogic** (medido en 12.2.0 sobre un
    dominio q35 de este mismo shell). Y ahí se juntan dos cosas:

      * Windows Server 2022 y Windows 11 NO traen driver para el LSI
        53C895A paralelo — Microsoft lo retiró hace años;
      * el `vioscsi` de virtio-win SOLO se engancha a una controladora
        **virtio-scsi**, así que cargarlo contra una lsilogic no encuentra
        nada que controlar.

    Resultado exacto del informe: "driver cargado, ningún disco". El disco
    estaba ahí y el driver también; lo que no casaba era la controladora.

    Solo se convierten las que NO llevan modelo o llevan el autoelegido; una
    controladora que alguien haya puesto a mano (lsisas1068, megasas…) se
    respeta, porque cambiarla sí dejaría un invitado sin arrancar.
    La <address> se suelta: la del modelo viejo no tiene por qué valer.
    """
    dev = devices(root)
    auto = ("", "auto", "lsilogic")
    found = False
    for c in dev.findall("controller"):
        if c.get("type") != "scsi":
            continue
        found = True
        if c.get("model", "") in auto:
            c.set("model", "virtio-scsi")
            for a in c.findall("address"):
                c.remove(a)
    if not found:
        ET.SubElement(dev, "controller",
                      {"type": "scsi", "index": "0", "model": "virtio-scsi"})
    return root


def cmd_nic_model(root, argv):
    """nic-model <mac> <modelo> — cambia el modelo de UNA interfaz.

    ⚠️ Windows NO trae driver en caja para **virtio-net**: el adaptador sale en
    el Administrador de dispositivos como desconocido y el invitado se queda
    SIN RED, por NAT y por puente igual (Linux sí lo trae, por eso solo fallaba
    en Windows). `e1000e` lo reconoce Windows solo, sin cargar nada.
    """
    mac, model = argv[0], argv[1]
    hit = False
    for nic in devices(root).findall("interface"):
        m = nic.find("mac")
        if m is None or m.get("address", "").lower() != mac.lower():
            continue
        hit = True
        mdl = nic.find("model")
        if mdl is None:
            mdl = ET.SubElement(nic, "model")
        mdl.set("type", model)
        # la dirección PCI la reasigna libvirt: la del modelo viejo puede no
        # valer para el nuevo (virtio-net es PCI Express, e1000e también, pero
        # rtl8139 no) y una address fija equivocada aborta el define.
        for a in nic.findall("address"):
            nic.remove(a)
    if not hit:
        die("no hay ninguna interfaz con la MAC %s en este dominio" % mac)
    return root


def cmd_sound(root, argv):
    """sound <modelo|none> — tarjeta de sonido del invitado."""
    model = argv[0]
    dev = devices(root)
    for sd in dev.findall("sound"):
        dev.remove(sd)
    if model != "none":
        ET.SubElement(dev, "sound", {"model": model})
    return root


def cmd_iface_get(root, argv):
    """iface-get <mac> — imprime SOLO el <interface> con esa MAC.

    Para `virsh detach-device`, que quita el dispositivo que le describa un
    trozo de XML. Es la forma FIABLE de quitar una interfaz:
    `detach-interface` obliga a acertar el TIPO (network/bridge/direct…) y si
    no coincide contesta "No interface with MAC address X was found" aunque la
    interfaz esté ahí delante. Aquí el tipo no hay que adivinarlo: se saca del
    dominio tal cual está en este instante.
    """
    mac = argv[0]
    for nic in devices(root).findall("interface"):
        m = nic.find("mac")
        if m is not None and m.get("address", "").lower() == mac.lower():
            sys.stdout.write(ET.tostring(nic, encoding="unicode"))
            return None
    die("no hay ninguna interfaz con la MAC %s en este dominio" % mac)


def cmd_nic_bridge(root, argv):
    """nic-bridge <mac> <puente> — pasa una interfaz a modo puente.

    `attach-interface` sabe crear una en modo bridge, pero CAMBIAR una que ya
    existe no tiene subcomando: se edita el XML.
    """
    mac, br = argv[0], argv[1]
    for nic in devices(root).findall("interface"):
        m = nic.find("mac")
        if m is None or m.get("address", "").lower() != mac.lower():
            continue
        nic.set("type", "bridge")
        src = nic.find("source")
        if src is None:
            src = ET.SubElement(nic, "source")
        for a in ("network", "dev", "portgroup"):
            src.attrib.pop(a, None)
        src.set("bridge", br)
        # el modo de virtualport de una red gestionada no vale para un puente
        for vp in nic.findall("virtualport"):
            nic.remove(vp)
    return root


def cmd_nic_network(root, argv):
    """nic-network <mac> <red> — devuelve una interfaz a una red de libvirt."""
    mac, net = argv[0], argv[1]
    for nic in devices(root).findall("interface"):
        m = nic.find("mac")
        if m is None or m.get("address", "").lower() != mac.lower():
            continue
        nic.set("type", "network")
        src = nic.find("source")
        if src is None:
            src = ET.SubElement(nic, "source")
        for a in ("bridge", "dev", "portgroup"):
            src.attrib.pop(a, None)
        src.set("network", net)
    return root


def cmd_desc(root, argv):
    d = root.find("description")
    txt = argv[0] if argv else ""
    if txt == "":
        if d is not None:
            root.remove(d)
        return root
    if d is None:
        d = ET.SubElement(root, "description")
    d.text = txt
    return root


def cmd_firmware(root, argv):
    """firmware bios|uefi — autoselección por descriptor, sin rutas OVMF."""
    want = argv[0]
    osnode = root.find("os")
    if osnode is None:
        die("el dominio no tiene <os>")
    for tag in ("loader", "nvram"):
        for el in osnode.findall(tag):
            osnode.remove(el)
    if want == "uefi":
        osnode.set("firmware", "efi")
    elif "firmware" in osnode.attrib:
        del osnode.attrib["firmware"]
    # <firmware> con <feature> lo genera libvirt sola; si venía de un dumpxml
    # de una VM ya definida hay que quitarlo o contradice el cambio.
    for f in osnode.findall("firmware"):
        osnode.remove(f)
    return root


def cmd_rename(root, argv):
    """rename <nombre-nuevo> — el UUID se suelta para que libvirt no choque."""
    new = argv[0]
    n = root.find("name")
    if n is None:
        die("el dominio no tiene <name>")
    n.text = new
    u = root.find("uuid")
    if u is not None:
        root.remove(u)
    return root


def cmd_clone(root, argv):
    """clone <nombre-nuevo> [viejo=nuevo ...] — copia lista para `define`.

    Suelta UUID y MACs (los genera libvirt), reescribe las rutas de disco que
    se le pasen y borra el estado que no puede heredarse.
    """
    new = argv[0]
    remap = {}
    for pair in argv[1:]:
        if "=" in pair:
            a, b = pair.split("=", 1)
            remap[a] = b
    n = root.find("name")
    if n is None:
        die("el dominio no tiene <name>")
    n.text = new
    for tag in ("uuid", "title", "description"):
        el = root.find(tag)
        if el is not None and tag == "uuid":
            root.remove(el)
    dev = devices(root)
    # MAC nueva por interfaz: dos VMs con la misma MAC en la misma red NAT se
    # pisan el DHCP.
    for nic in dev.findall("interface"):
        m = nic.find("mac")
        if m is not None:
            nic.remove(m)
    for dsk in dev.findall("disk"):
        s = dsk.find("source")
        if s is None:
            continue
        for attr in ("file", "dev", "dir"):
            v = s.get(attr)
            if v and v in remap:
                s.set(attr, remap[v])
    # el varstore UEFI es por-VM: heredarlo apuntaría al de la original
    osnode = root.find("os")
    if osnode is not None:
        for nv in osnode.findall("nvram"):
            osnode.remove(nv)
    return root


COMMANDS = {
    "info": cmd_info,
    "boot": cmd_boot,
    "video": cmd_video,
    "cpu": cmd_cpu,
    "spice-agent": cmd_spice_agent,
    "clipboard": cmd_clipboard,
    "usbredir": cmd_usbredir,
    "fs-add": cmd_fs_add,
    "fs-del": cmd_fs_del,
    "usb-add": cmd_usb_add,
    "usb-del": cmd_usb_del,
    "controller-add": cmd_controller_add,
    "scsi-virtio": cmd_scsi_virtio,
    "tpm": cmd_tpm,
    "nic-model": cmd_nic_model,
    "desc": cmd_desc,
    "sound": cmd_sound,
    "iface-get": cmd_iface_get,
    "nic-bridge": cmd_nic_bridge,
    "nic-network": cmd_nic_network,
    "firmware": cmd_firmware,
    "rename": cmd_rename,
    "clone": cmd_clone,
}


# Órdenes que ya han escrito su propia salida: no se les añade el dominio.
SELF_PRINTING = ("info", "iface-get")


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        die("uso: vexyon-vm-xml <%s> [args…]  (XML por stdin)"
            % "|".join(sorted(COMMANDS)))
    cmd = sys.argv[1]
    try:
        root = ET.fromstring(sys.stdin.read())
    except ET.ParseError as e:
        die("XML de dominio ilegible: %s" % e)
    out = COMMANDS[cmd](root, sys.argv[2:])
    # `info` e `iface-get` escriben ELLAS lo que toca (una tabla, un fragmento);
    # las demás son filtros y devuelven el dominio entero ya modificado.
    if cmd not in SELF_PRINTING:
        emit(out)


if __name__ == "__main__":
    main()
